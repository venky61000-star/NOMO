    if(!title || isNaN(entry) || isNaN(win)) {
        alert("Please provide a valid match title, entry fee, and prize amount.");
        return;
    }
    
    const matchesData = getStoredMatches();
    const newId = currentManagingCategory + '-' + Date.now();
    
    matchesData[currentManagingCategory].push({
        id: newId,
        title,
        entry,
        win,
        max: maxSeats
    });
    
    saveStoredMatches(matchesData);
    newMatchTitleInput.value = "";
    renderAdminMatchList();
    renderAllDynamicMatches();
    alert("Match scheduled successfully with configured slots!");
});

function deleteCustomMatch(matchId) {
    if(!confirm("Are you sure you want to delete this match?")) return;
    const matchesData = getStoredMatches();
    matchesData[currentManagingCategory] = matchesData[currentManagingCategory].filter(m => m.id !== matchId);

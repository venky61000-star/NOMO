<script>
let currentUser = null, userWalletBalance = 0;
let userJoinedMatches = [];
let lastActiveSourcePage = null;
let currentActiveCard = null;

const USERS_KEY = "nomo_secure_users_v3", SESSION_KEY = "nomo_current_session_v3", REQUESTS_KEY = "nomo_admin_requests_v3", MATCHES_KEY = "nomo_custom_matches_v3";
const ADMIN_CREDENTIALS = {username:"admin", password:"nomoadmin2026"};
const walletBalanceEl = document.getElementById("walletBalance"), headerAuthBtn = document.getElementById("headerAuthBtn");

// Default match store updated with Body & Heads
const defaultMatches = {
    br: [
        { id: 'br-1', title: '9:00 AM BR Room', entry: 40, win: 700, max: 20 },
        { id: 'br-2', title: '9:40 AM BR Room', entry: 40, win: 700, max: 20 }
    ],
    cs: [
        { id: 'cs-1', title: '9:00 AM Body & Heads (1v1)', entry: 50, win: 90, max: 2, type: '1v1' },
        { id: 'cs-2', title: '9:30 AM Body & Heads (2v2)', entry: 50, win: 90, max: 4, type: '2v2' }
    ],
    lonewolf: [
        { id: 'lw-1', title: 'Lone Wolf 1v1 Arena', entry: 50, win: 90, max: 2, type: '1v1' },
        { id: 'lw-2', title: 'Lone Wolf 2v2 Arena', entry: 50, win: 90, max: 4, type: '2v2' }
    ]
};

function getStoredMatches() {
    try {
        const data = JSON.parse(localStorage.getItem(MATCHES_KEY));
        return data || defaultMatches;
    } catch(e) {
        return defaultMatches;
    }
}
function saveStoredMatches(matches) {
    localStorage.setItem(MATCHES_KEY, JSON.stringify(matches));
}

function getStoredUsers() {
    try { const users = JSON.parse(localStorage.getItem(USERS_KEY)); return Array.isArray(users) ? users : []; } catch(e) { return []; }
}
function saveStoredUsers(users) { localStorage.setItem(USERS_KEY, JSON.stringify(users)); }

function getStoredRequests() {
    try { const reqs = JSON.parse(localStorage.getItem(REQUESTS_KEY)); return Array.isArray(reqs) ? reqs : []; } catch(e) { return []; }
}
function saveStoredRequests(reqs) { localStorage.setItem(REQUESTS_KEY, JSON.stringify(reqs)); }

function saveSession() {
    if(!currentUser) { localStorage.removeItem(SESSION_KEY); return; }
    localStorage.setItem(SESSION_KEY, JSON.stringify({username:currentUser.username, isAdmin:!!currentUser.isAdmin}));
}
function loadSession() {
    try {
        const saved = JSON.parse(localStorage.getItem(SESSION_KEY));
        if(!saved || !saved.username) return false;
        if(saved.isAdmin) { currentUser = {username:saved.username, isAdmin:true}; return true; }
        const users = getStoredUsers();
        const user = users.find(u => u.username && u.username.toLowerCase() === saved.username.toLowerCase());
        if(!user) { localStorage.removeItem(SESSION_KEY); return false; }
        currentUser = {username:user.username, isAdmin:false};
        userWalletBalance = user.wallet || 0;
        return true;
    } catch(e) { localStorage.removeItem(SESSION_KEY); return false; }
}
function saveWallet() {
    if(!currentUser || currentUser.isAdmin) return;
    const users = getStoredUsers(), i = users.findIndex(u => u.username.toLowerCase() === currentUser.username.toLowerCase());
    if(i !== -1) { users[i].wallet = userWalletBalance; saveStoredUsers(users); }
}
function updateWalletDisplay() { walletBalanceEl.textContent = `₹${userWalletBalance.toLocaleString("en-IN")}`; }
function updateHeaderAccount() {
    if(!currentUser) {
        headerAuthBtn.innerHTML = '<span>Drop In.</span> Wipe Out. Take Crown.';
    } else if(currentUser.isAdmin) {
        headerAuthBtn.innerHTML = '<span>👑 ADMIN</span> Control Center';
    } else {
        headerAuthBtn.innerHTML = `<span>👤 ${currentUser.username}</span> Match Hub`;
    }
}
function updateAdminUI() {
    const isAdmin = currentUser && currentUser.isAdmin;
    document.querySelectorAll(".admin-override-banner").forEach(b => b.style.display = isAdmin ? "block" : "none");
    document.querySelectorAll(".admin-menu-item").forEach(b => b.style.display = isAdmin ? "block" : "none");
    const adminUsersMenuBtn = document.getElementById("adminUsersMenuBtn");
    if(adminUsersMenuBtn) adminUsersMenuBtn.style.display = isAdmin ? "block" : "none";
    
    const reqMenuLabel = document.getElementById("requestsMenuLabel");
    const reqMenuSub = document.getElementById("requestsMenuSub");
    if(isAdmin) {
        reqMenuLabel.textContent = "👑 Requests";
        reqMenuSub.textContent = "Manage All Deposits & Withdrawals";
    } else {
        reqMenuLabel.textContent = "📋 My Requests";
        reqMenuSub.textContent = "View Deposit & Withdrawal Status";
    }
}

async function hashPassword(password) {
    const buffer = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(password));
    return Array.from(new Uint8Array(buffer)).map(b => b.toString(16).padStart(2,"0")).join("");
}

const dropdownMenu = document.getElementById("dropdownMenu");
headerAuthBtn.addEventListener("click", e => {
    e.stopPropagation();
    if(!currentUser) {
        loginMsg.textContent = "";
        switchPage(document.querySelector(".page.page-active"), loginPage);
    } else {
        dropdownMenu.classList.toggle("active");
    }
});
window.addEventListener("click", () => dropdownMenu.classList.remove("active"));

const homePage = document.getElementById("home-page"), loginPage = document.getElementById("login-page"),
      signupPage = document.getElementById("signup-page"), optionsPage = document.getElementById("options-page"),
      adminUsersPage = document.getElementById("admin-users-page"), adminRequestsPage = document.getElementById("admin-requests-page"),
      brMapsPage = document.getElementById("br-maps-page"), csModesPage = document.getElementById("cs-modes-page"),
      lonewolfModesPage = document.getElementById("lonewolf-modes-page"), headshotTimesPage = document.getElementById("headshot-times-page"),
      myMatchesPage = document.getElementById("my-matches-page"), roomLobbyPage = document.getElementById("room-lobby-page");

function switchPage(fromPage, toPage) {
    if(fromPage) fromPage.classList.remove("page-active");
    toPage.classList.add("page-active");
    window.scrollTo({top:0, behavior:"smooth"});
}

const loginUsername = document.getElementById("loginUsername"), loginPassword = document.getElementById("loginPassword"),
      signupUsername = document.getElementById("signupUsername"), signupPassword = document.getElementById("signupPassword"), 
      submitLoginBtn = document.getElementById("submitLoginBtn"), submitSignupBtn = document.getElementById("submitSignupBtn"), 
      loginMsg = document.getElementById("loginMsg"), signupMsg = document.getElementById("signupMsg");

const profileModal = document.getElementById("profileModal"), profileAvatar = document.getElementById("profileAvatar"),
      profileName = document.getElementById("profileName"), profileUsernameDisplay = document.getElementById("profileUsernameDisplay"),
      profileIgn = document.getElementById("profileIgn"), profileStatus = document.getElementById("profileStatus"),
      profileBalance = document.getElementById("profileBalance");

const depositModal = document.getElementById("depositModal"), depositCancelBtn = document.getElementById("depositCancelBtn"),
      depositConfirmBtn = document.getElementById("depositConfirmBtn"), depositAmountInput = document.getElementById("depositAmountInput"),
      depositUtrInput = document.getElementById("depositUtrInput");

document.getElementById("depositMenuBtn").addEventListener("click", () => {
    if(!currentUser) { switchPage(document.querySelector(".page.page-active"), loginPage); return; }
    depositAmountInput.value = ""; depositUtrInput.value = "";
    depositModal.classList.add("active");
    dropdownMenu.classList.remove("active");
});
depositCancelBtn.addEventListener("click", () => depositModal.classList.remove("active"));
depositConfirmBtn.addEventListener("click", () => {
    const amt = parseFloat(depositAmountInput.value);
    const utr = depositUtrInput.value.trim();
    if(isNaN(amt) || amt < 50) { alert("Minimum deposit amount is ₹50."); return; }
    if(!utr) { alert("Please provide the transaction reference ID or UTR."); return; }
    
    const reqs = getStoredRequests();
    reqs.unshift({
        id: 'DEP-' + Date.now(),
        type: 'deposit',
        username: currentUser.isAdmin ? 'Admin' : currentUser.username,
        amount: amt,
        details: 'UTR: ' + utr,
        status: 'pending',
        date: new Date().toLocaleString()
    });
    saveStoredRequests(reqs);

    if(currentUser.isAdmin) {
        alert(`Admin deposit simulation of ₹${amt} recorded.`);
    } else {
        alert(`Deposit request of ₹${amt} submitted successfully! Awaiting admin approval.`);
    }
    depositModal.classList.remove("active");
});

const withdrawModal = document.getElementById("withdrawModal"), withdrawCancelBtn = document.getElementById("withdrawCancelBtn"),
      withdrawConfirmBtn = document.getElementById("withdrawConfirmBtn"), withdrawAmountInput = document.getElementById("withdrawAmountInput"),
      tabBankBtn = document.getElementById("tabBankBtn"), tabUpiBtn = document.getElementById("tabUpiBtn"),
      bankFormSection = document.getElementById("bankFormSection"), upiFormSection = document.getElementById("upiFormSection"),
      bankNameInput = document.getElementById("bankNameInput"), bankAccInput = document.getElementById("bankAccInput"),
      bankIfscInput = document.getElementById("bankIfscInput"), upiIdInput = document.getElementById("upiIdInput");

function switchWithdrawTab(tab) {
    if(tab === 'bank') {
        tabBankBtn.classList.add("active"); tabUpiBtn.classList.remove("active");

}

function handleAdminRequest(reqId, action) {
    if(!currentUser || !currentUser.isAdmin) return;
    const reqs = getStoredRequests();
    const req = reqs.find(r => r.id === reqId);
    if(!req) return;
    
    if(action === 'approve') {
        req.status = 'approved';
        if(req.type === 'deposit') {
            const users = getStoredUsers();
            const targetUser = users.find(u => u.username.toLowerCase() === req.username.toLowerCase());
            if(targetUser) {
                targetUser.wallet = (targetUser.wallet || 0) + req.amount;
                saveStoredUsers(users);
            }
        }
        alert(`Request ${req.id} approved successfully!`);
    } else {
        req.status = 'rejected';
        if(req.type === 'withdraw') {
            const users = getStoredUsers();
            const targetUser = users.find(u => u.username.toLowerCase() === req.username.toLowerCase());
            if(targetUser) {
                targetUser.wallet = (targetUser.wallet || 0) + req.amount;
                saveStoredUsers(users);
            }
        }
        alert(`Request ${req.id} rejected.`);
    }
    saveStoredRequests(reqs);
    renderAdminRequestsList(currentAdminReqTab);
}


<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NOMO IND — Free Fire Tournaments</title>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Cinzel:wght@600;700&display=swap" rel="stylesheet">
<style>
:root {
    --bg-color:#FAFAFC;--card-bg:#FFFFFF;--text-main:#0A0A0C;--text-muted:#55555D;
    --accent:#D4AF37;--border-color:#EAEAEF;--cardboard-bg:#F4F4F7;--cardboard-border:#DCDCE2;
    --cardboard-hover:#EBEBF0;--cardboard-deep:#ECECEF;--shadow-hover:0 20px 40px -10px rgba(0,0,0,.06);
}
*{margin:0;padding:0;box-sizing:border-box;scroll-behavior:smooth;}
body{font-family:'Plus Jakarta Sans',sans-serif;background:var(--bg-color);color:var(--text-main);line-height:1.7;overflow-x:hidden;}
header{position:fixed;top:0;left:0;width:100%;background:rgba(250,250,252,.9);backdrop-filter:blur(16px);border-bottom:1px solid var(--border-color);z-index:1000;display:flex;justify-content:space-between;align-items:center;padding:1.2rem 6%;}
.logo{font-size:1.25rem;font-weight:700;letter-spacing:2px;color:var(--text-main);text-transform:uppercase;margin-top:4px;}
.logo span{color:var(--accent);font-weight:400;}
.header-right{display:flex;align-items:center;gap:15px;margin-top:6px;}
.corner-slogan-badge{background:var(--cardboard-bg);border:1px solid var(--cardboard-border);padding:.5rem 1rem;border-radius:6px;font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--text-muted);display:flex;align-items:center;gap:8px;cursor:pointer;box-shadow:0 4px 12px rgba(0,0,0,.03);}
.corner-slogan-badge span{color:var(--accent);font-family:'Cinzel',serif;font-size:.8rem;}
.corner-slogan-badge:hover{background:var(--cardboard-hover);}
.dropdown-menu{position:absolute;top:54px;right:0;width:240px;background:var(--card-bg);border:1px solid var(--border-color);border-radius:8px;box-shadow:var(--shadow-hover);padding:.5rem;display:flex;flex-direction:column;gap:.3rem;opacity:0;transform:translateY(-10px);pointer-events:none;transition:.25s;z-index:1200;}
.dropdown-menu.active{opacity:1;transform:translateY(0);pointer-events:auto;}
.dropdown-balance{background:var(--cardboard-bg);border:1px solid var(--cardboard-border);padding:.7rem 1rem;border-radius:6px;font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--text-muted);}
.dropdown-balance span{display:block;color:var(--accent);font-size:.95rem;margin-top:2px;}
.dropdown-item,.btn-back,.cardboard-btn{background:transparent;border:none;color:var(--text-main);cursor:pointer;text-transform:uppercase;}
.dropdown-item{padding:.7rem 1rem;border-radius:4px;font-size:.8rem;font-weight:600;letter-spacing:1px;text-align:left;width:100%;}
.dropdown-item:hover{background:var(--cardboard-bg);}
.btn-start{background:var(--text-main);color:#fff;padding:.85rem 2.2rem;border-radius:4px;font-weight:600;font-size:.85rem;letter-spacing:1.5px;text-transform:uppercase;display:inline-flex;align-items:center;gap:10px;border:none;cursor:pointer;}
.btn-start:hover{background:var(--accent);}
.page-container{position:relative;width:100%;min-height:100vh;}
.page{position:absolute;top:0;left:0;width:100%;min-height:100vh;background:var(--bg-color);transition:transform .8s cubic-bezier(.645,.045,.355,1),opacity .8s;pointer-events:none;opacity:0;transform:translateX(100%);}
.page.page-active{opacity:1;transform:translateX(0);pointer-events:auto;position:relative;}
#home-page{transform:translateX(0);opacity:1;pointer-events:auto;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:14rem 6% 8rem;}
.hero-badge{background:#fff;border:1px solid var(--border-color);padding:.4rem 1.2rem;border-radius:30px;font-size:.75rem;font-weight:600;text-transform:uppercase;letter-spacing:2px;margin-bottom:2rem;color:var(--text-muted);}
#home-page h1{font-size:clamp(2.5rem,5vw,4.2rem);font-weight:700;line-height:1.15;margin-bottom:1.5rem;}
#home-page h1 span{color:var(--accent);display:block;font-family:'Cinzel',serif;font-size:.65em;margin-top:.6rem;}
#home-page p{font-size:1.1rem;color:var(--text-muted);max-width:580px;margin-bottom:3rem;}
.cardboard-btn{display:block;background:var(--cardboard-bg);border:1px solid var(--cardboard-border);color:var(--text-main);padding:.8rem 1.4rem;border-radius:6px;font-size:.8rem;font-weight:700;letter-spacing:1px;text-align:center;width:100%;}
.cardboard-btn:hover{background:var(--cardboard-hover);}
.admin-override-banner{background:linear-gradient(145deg,#1A1A1E,#2A2A30);border:1px solid var(--accent);color:#fff;padding:.6rem;border-radius:6px;font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:1px;text-align:center;cursor:pointer;margin-bottom:1rem;display:none;}
.auth-container{max-width:440px;margin:auto;padding:9rem 6% 6rem;}
.cardboard-auth-card,.luxury-card,.headshot-room-card{background:linear-gradient(145deg,#fff,var(--cardboard-deep));border:1px solid var(--cardboard-border);border-radius:12px;}
.cardboard-auth-card{padding:2.5rem 2rem;box-shadow:0 12px 30px rgba(0,0,0,.05);}
.auth-header{text-align:center;margin-bottom:2rem;}
.auth-header h2{font-size:1.4rem;margin-bottom:.4rem;}
.auth-header p,.auth-switch-text,.auth-msg,.room-member-badge,.seating-label,.profile-detail-row span{font-size:.85rem;color:var(--text-muted);}
.auth-form-group{display:flex;flex-direction:column;gap:1.2rem;margin-bottom:1.5rem;}
.auth-field-wrap label{display:block;font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--text-muted);margin-bottom:.4rem;}
.auth-input,.player-input-field,.chat-input{width:100%;background:#fff;border:1px solid var(--cardboard-border);padding:.8rem 1rem;border-radius:6px;font-family:inherit;font-size:.88rem;color:var(--text-main);outline:none;}
.auth-input:focus,.player-input-field:focus,.chat-input:focus{border-color:var(--accent);}
.auth-switch-text{text-align:center;margin-top:1.5rem;}
.auth-switch-text a{color:var(--accent);font-weight:700;cursor:pointer;}
.auth-msg{margin-top:1rem;text-align:center;font-weight:600;}
.auth-msg.error{color:#d9534f;}
.auth-msg.success{color:#5cb85c;}
.back-nav{padding:8rem 6% 0;margin-bottom:-2rem;}
.btn-back{border:1px solid var(--border-color);padding:.5rem 1.2rem;border-radius:4px;font-size:.8rem;font-weight:600;letter-spacing:1px;}
.btn-back:hover{background:var(--text-main);color:#fff;}
.features{padding:8rem 6% 6rem;max-width:1200px;margin:auto;}
.features.sub-page{padding-top:4rem;}
.section-title{text-align:center;margin-bottom:3.5rem;}
.section-title h2{font-size:2rem;}
.section-title p{color:var(--text-muted);margin-top:.5rem;font-size:.95rem;}
.card-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:2rem;}
.luxury-card,.headshot-room-card{padding:2.2rem 1.8rem;box-shadow:0 8px 24px rgba(0,0,0,.04);position:relative;}
.luxury-card{min-height:260px;display:flex;flex-direction:column;justify-content:space-between;}
.card-tag{display:inline-block;font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;color:var(--accent);margin-bottom:1rem;}
.room-top-meta,.match-pricing{display:flex;justify-content:space-between;align-items:center;}
.room-top-meta{margin-bottom:.8rem;}
.room-member-badge{background:var(--cardboard-bg);border:1px solid var(--cardboard-border);padding:.3rem .7rem;border-radius:20px;font-size:.7rem;font-weight:700;}
.match-pricing{background:rgba(255,255,255,.6);border:1px solid var(--cardboard-border);padding:.6rem .9rem;border-radius:6px;font-size:.75rem;font-weight:700;text-transform:uppercase;margin:1rem 0;}
.match-pricing span{color:var(--text-main);}
.match-pricing .win-amount{color:var(--accent);}
.seating-section{margin-top:1rem;padding-top:1rem;border-top:1px dashed var(--cardboard-border);}
.seating-label{font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:1px;text-align:center;margin-bottom:10px;}
.seats-grid{display:flex;flex-wrap:wrap;gap:6px;justify-content:center;max-height:180px;overflow-y:auto;}
.seat-box{width:38px;height:38px;background:#fff;border:2px solid var(--cardboard-border);border-radius:6px;display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:pointer;}
.seat-box:hover:not(.filled){border-color:var(--accent);}
.seat-box.filled{background:#F0F5F1;border-color:#A3C9A8;}
.seat-box span{font-size:7px;text-transform:uppercase;color:var(--text-muted);}
.seat-box b{font-size:10px;}
.seat-box.filled b{color:#2D6A4F;font-size:8px;max-width:32px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.tear-overlay{position:absolute;top:0;left:0;width:100%;height:100%;z-index:20;pointer-events:none;display:none;}
.tear-overlay.active{display:block;}
.tear-half{position:absolute;top:0;width:50%;height:100%;background:#E8E8ED;transition:.6s;}
.tear-half.left{left:0;}
.tear-half.right{right:0;}
.tear-watermark{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-family:'Cinzel',serif;font-size:1rem;white-space:nowrap;}
.headshot-room-card.tearing .tear-half.left{transform:translateX(-100%) rotate(-8deg);opacity:0;}
.headshot-room-card.tearing .tear-half.right{transform:translateX(100%) rotate(8deg);opacity:0;}
.notification-modal-overlay{position:fixed;inset:0;background:rgba(10,10,12,.4);backdrop-filter:blur(4px);z-index:2000;display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:.25s;}
.notification-modal-overlay.active{opacity:1;pointer-events:auto;}
.notification-card{background:linear-gradient(145deg,#fff,var(--cardboard-deep));border:1px solid var(--cardboard-border);border-radius:12px;width:90%;max-width:420px;padding:2rem 1.6rem;text-align:center;box-shadow:0 20px 40px rgba(0,0,0,.1);max-height:90vh;overflow-y:auto;}
.notification-card h3{margin-bottom:.4rem;}
.notification-card p{font-size:.85rem;color:var(--text-muted);margin-bottom:1.2rem;}
.player-inputs-group{margin-bottom:1.5rem;text-align:left;}
.player-input-wrap{margin-bottom:.8rem;}
.player-input-wrap label{display:block;font-size:.72rem;font-weight:700;text-transform:uppercase;color:var(--text-muted);margin-bottom:.3rem;}
.notification-actions{display:flex;gap:10px;}
.notification-actions button{flex:1;}
.btn-cancel-modal{background:#EAEAEF;border:1px solid var(--cardboard-border);color:var(--text-muted);padding:.75rem 1rem;border-radius:6px;font-size:.78rem;font-weight:700;text-transform:uppercase;cursor:pointer;}
.withdraw-tabs{display:flex;gap:8px;margin-bottom:1.2rem;}
.withdraw-tab-btn{flex:1;background:var(--cardboard-bg);border:1px solid var(--cardboard-border);padding:.5rem;border-radius:6px;font-size:.72rem;font-weight:700;cursor:pointer;text-transform:uppercase;}
.withdraw-tab-btn.active{background:var(--text-main);color:#fff;border-color:var(--text-main);}
.withdraw-form-section{display:none;text-align:left;}
.withdraw-form-section.active{display:block;}
.room-lobby-container{max-width:800px;margin:auto;padding:8rem 6% 6rem;display:flex;flex-direction:column;gap:2rem;}
.cardboard-room-info-card{background:linear-gradient(145deg,#fff,var(--cardboard-deep));border:1px solid var(--cardboard-border);border-radius:12px;padding:2rem;text-align:center;}
.credentials-box{background:#fff;border:1px dashed var(--cardboard-border);border-radius:8px;padding:1.5rem;margin-top:1rem;}
.credentials-box h4{font-size:.85rem;text-transform:uppercase;color:var(--accent);}
.creds-display{font-size:1rem;font-weight:700;}
.lobby-cardboard-roster{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;}
.white-cardboard-box{background:#fff;border:1px solid var(--cardboard-border);border-top:4px solid var(--accent);border-radius:8px;padding:.9rem 1rem;text-align:center;display:flex;flex-direction:column;justify-content:space-between;gap:8px;}
.white-cardboard-box span{display:block;font-size:.68rem;font-weight:700;text-transform:uppercase;color:var(--text-muted);}
.white-cardboard-box b{display:block;font-size:.88rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.admin-wallet-btn{background:var(--accent);color:#0A0A0C;border:none;padding:.3rem .6rem;border-radius:4px;font-size:.65rem;font-weight:700;text-transform:uppercase;cursor:pointer;}
.admin-wallet-btn:hover{opacity:.9;}
.admin-chat-container{background:#fff;border:1px solid var(--border-color);border-radius:12px;display:flex;flex-direction:column;height:380px;overflow:hidden;}
.chat-header{background:var(--cardboard-bg);border-bottom:1px solid var(--cardboard-border);padding:1rem 1.5rem;display:flex;justify-content:space-between;}
.chat-header h4{font-size:.9rem;text-transform:uppercase;}
.admin-badge-indicator{color:#A68724;font-size:.7rem;font-weight:700;}
.chat-messages-area{flex:1;padding:1.2rem;overflow-y:auto;display:flex;flex-direction:column;gap:.8rem;}
.chat-msg{max-width:80%;padding:.8rem 1rem;border-radius:8px;font-size:.88rem;}
.chat-msg.admin{background:linear-gradient(145deg,#fff,var(--cardboard-deep));border:1px solid var(--cardboard-border);align-self:flex-start;}
.chat-msg.user-sent{background:#F0F5F1;border:1px solid #A3C9A8;align-self:flex-end;}
.chat-msg-sender{font-size:.72rem;font-weight:700;color:var(--accent);margin-bottom:.2rem;}
.chat-footer{border-top:1px solid var(--border-color);padding:.8rem 1.2rem;display:flex;align-items:center;gap:12px;}
.chat-input{flex:1;border:none;outline:none;font-size:.9rem;background:transparent;}
.btn-send-chat{background:var(--text-main);color:#fff;border:none;padding:.6rem 1.2rem;border-radius:6px;font-size:.8rem;font-weight:700;cursor:pointer;}
.chat-restricted-notice{font-size:.7rem;color:var(--text-muted);text-align:center;padding:.4rem;background:var(--cardboard-bg);border-top:1px solid var(--border-color);}
.profile-card{max-width:390px;}
.profile-avatar{width:72px;height:72px;margin:0 auto 1rem;border-radius:50%;background:var(--text-main);color:var(--accent);display:flex;align-items:center;justify-content:center;font-family:'Cinzel',serif;font-size:1.6rem;font-weight:700;border:2px solid var(--accent);}
.profile-details{background:#fff;border:1px solid var(--cardboard-border);border-radius:8px;overflow:hidden;text-align:left;}
.profile-detail-row{display:flex;justify-content:space-between;align-items:center;padding:.9rem 1rem;border-bottom:1px solid var(--border-color);}
.profile-detail-row:last-child{border-bottom:none;}
.profile-detail-row span{letter-spacing:1px;}
.profile-detail-row b{font-size:.82rem;color:var(--text-main);}
.nomo-footer{background:var(--cardboard-deep);border-top:1px solid var(--border-color);padding:3rem 6%;text-align:center;margin-top:4rem;}
.nomo-footer .footer-logo{font-size:1.1rem;font-weight:700;letter-spacing:2px;color:var(--text-main);text-transform:uppercase;margin-bottom:1rem;}
.nomo-footer .footer-logo span{color:var(--accent);font-weight:400;}
.footer-slogans{display:flex;flex-direction:column;gap:.4rem;font-size:.85rem;color:var(--text-muted);font-weight:600;letter-spacing:.5px;}
.footer-slogans span:nth-child(2){color:var(--accent);font-family:'Cinzel',serif;font-size:.95rem;}

/* Floating Support Chat Widget Styles */
.support-chat-float-btn{position:fixed;bottom:25px;right:25px;background:var(--text-main);color:var(--accent);border:2px solid var(--accent);width:58px;height:58px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.4rem;cursor:pointer;box-shadow:0 10px 25px rgba(0,0,0,.15);z-index:2500;transition:.3s;}
.support-chat-float-btn:hover{transform:scale(1.08);background:var(--accent);color:#0A0A0C;}
.support-chat-window{position:fixed;bottom:95px;right:25px;width:350px;max-width:90vw;background:var(--card-bg);border:1px solid var(--cardboard-border);border-radius:12px;box-shadow:var(--shadow-hover);display:flex;flex-direction:column;height:420px;z-index:2500;opacity:0;transform:translateY(20px);pointer-events:none;transition:.3s;}
.support-chat-window.active{opacity:1;transform:translateY(0);pointer-events:auto;}
.support-chat-header{background:var(--cardboard-bg);border-bottom:1px solid var(--cardboard-border);padding:1rem;display:flex;justify-content:space-between;align-items:center;border-top-left-radius:12px;border-top-right-radius:12px;}
.support-chat-header h4{font-size:.85rem;text-transform:uppercase;}
.support-chat-close{background:transparent;border:none;font-size:1.1rem;cursor:pointer;color:var(--text-muted);}
.support-chat-body{flex:1;padding:1rem;overflow-y:auto;display:flex;flex-direction:column;gap:.8rem;}
.support-msg{max-width:85%;padding:.7rem .9rem;border-radius:8px;font-size:.82rem;}
.support-msg.agent{background:var(--cardboard-bg);border:1px solid var(--cardboard-border);align-self:flex-start;}
.support-msg.customer{background:#F0F5F1;border:1px solid #A3C9A8;align-self:flex-end;}
.support-chat-footer{border-top:1px solid var(--border-color);padding:.8rem;display:flex;gap:8px;}
.support-chat-input{flex:1;border:1px solid var(--cardboard-border);padding:.6rem .8rem;border-radius:6px;font-size:.85rem;outline:none;}
.support-chat-input:focus{border-color:var(--accent);}
.support-send-btn{background:var(--text-main);color:#fff;border:none;padding:.6rem 1rem;border-radius:6px;font-size:.78rem;font-weight:700;cursor:pointer;}

@media(max-width:600px){
    header{padding:1rem 4%;}
    .header-right{gap:7px;}
    .corner-slogan-badge{font-size:.65rem;padding:.4rem .7rem;}
    .card-grid{grid-template-columns:1fr;}
    #home-page{padding:14rem 5% 8rem;}
}
</style>
</head>
<body>

<header>
    <div class="logo">NOMO <span>IND</span></div>
    <div class="header-right">
        <div class="corner-slogan-badge" id="headerAuthBtn">
            <span>Drop In.</span> Wipe Out. Take Crown.
        </div>
        <div class="floating-menu-wrapper" style="position:relative;">
            <div class="dropdown-menu" id="dropdownMenu">
                <div class="dropdown-balance">Balance <span id="walletBalance">₹0</span></div>
                <button class="dropdown-item" id="depositMenuBtn">Deposit</button>
                <button class="dropdown-item" id="withdrawMenuBtn">Withdraw</button>
                <button class="dropdown-item" id="profileMenuBtn">Profile</button>
                <button class="dropdown-item" id="myMatchesMenuBtn">My Matches</button>
                
                <!-- Admin Match Schedule Menu Items -->
                <button class="dropdown-item admin-menu-item" id="adminScheduleBrBtn" style="display:none; color:var(--accent); font-weight:700;">👑 Schedule/Slots BR</button>
                <button class="dropdown-item admin-menu-item" id="adminScheduleCsBtn" style="display:none; color:var(--accent); font-weight:700;">👑 Schedule/Slots CS</button>
                <button class="dropdown-item admin-menu-item" id="adminScheduleLwBtn" style="display:none; color:var(--accent); font-weight:700;">👑 Schedule/Slots Lonewolf</button>

                <button class="dropdown-item" id="adminUsersMenuBtn" style="display:none; color:var(--accent); font-weight:700;">👑 Manage Users</button>
                <button class="dropdown-item" id="adminRequestsMenuBtn" style="color:var(--accent); font-weight:700; line-height:1.2; padding:.8rem 1rem;">
                    <span id="requestsMenuLabel">👑 Requests</span><br>
                    <span style="font-size:0.65rem; color:var(--text-muted); font-weight:500;" id="requestsMenuSub">Deposits & Withdrawals</span>
                </button>
                <button class="dropdown-item" onclick="toggleSupportChat()">Support Chat</button>
                <button class="dropdown-item" id="logoutMenuBtn" style="color:#C0392B;">Logout</button>
            </div>
        </div>
    </div>
</header>

<!-- Floating Support Chat Widget -->
<div class="support-chat-float-btn" onclick="toggleSupportChat()" title="Customer Support">💬</div>
<div class="support-chat-window" id="supportChatWindow">
    <div class="support-chat-header">
        <h4>NOMO Support Center</h4>
        <button class="support-chat-close" onclick="toggleSupportChat()">✕</button>
    </div>
    <div class="support-chat-body" id="supportChatMessages">
        <div class="support-msg agent">
            <b>NOMO Agent:</b> Hello! How can we assist you with your matches, deposits, or withdrawals today?
        </div>
    </div>
    <div class="support-chat-footer">
        <input type="text" class="support-chat-input" id="supportChatInput" placeholder="Type your message...">
        <button class="support-send-btn" id="supportSendBtn" onclick="sendSupportMessage()">Send</button>
    </div>
</div>

<!-- Admin Match Management Modal -->
<div class="notification-modal-overlay" id="adminMatchModal">
    <div class="notification-card" style="max-width: 520px;">
        <h3 id="adminMatchModalTitle">Manage Matches & Player Slots</h3>
        <p>Schedule matches, adjust pricing, and dynamically add or remove player slots.</p>
        
        <div class="player-inputs-group">
            <div class="player-input-wrap">
                <label>Match Title / Time Slot</label>
                <input type="text" class="player-input-field" id="newMatchTitleInput" placeholder="e.g. 10:00 AM Custom Room">
            </div>
            <div style="display: flex; gap: 10px;">
                <div class="player-input-wrap" style="flex:1;">
                    <label>Entry Fee (₹)</label>
                    <input type="number" class="player-input-field" id="newMatchEntryInput" value="40">
                </div>
                <div class="player-input-wrap" style="flex:1;">
                    <label>Win Prize (₹)</label>
                    <input type="number" class="player-input-field" id="newMatchWinInput" value="700">
                </div>
                <div class="player-input-wrap" style="flex:1;">
                    <label>Max Seats</label>
                    <input type="number" class="player-input-field" id="newMatchMaxSeatsInput" value="20" min="2" max="50">
                </div>
            </div>
        </div>
        
        <button class="cardboard-btn" id="addNewMatchBtn" style="margin-bottom: 15px;">Schedule New Match</button>
        

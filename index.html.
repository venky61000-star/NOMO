document.getElementById("backToOptionsFromMatchesBtn").addEventListener("click", () => switchPage(myMatchesPage, optionsPage));

const notificationModal = document.getElementById("notificationModal"), modalCancelBtn = document.getElementById("modalCancelBtn"),
      modalConfirmBtn = document.getElementById("modalConfirmBtn"), modalSeatTitle = document.getElementById("modalSeatTitle"),
      modalSeatSubtitle = document.getElementById("modalSeatSubtitle"), modalInputLabel = document.getElementById("modalInputLabel"),
      seatPlayerInput = document.getElementById("seatPlayerInput");

let activeSeatElement = null, activeCard = null;

[document.getElementById("brCardsContainer"), document.getElementById("headshotCardsContainer"), document.getElementById("lonewolfCardsContainer")].forEach(container => {
    if(!container) return;
    container.addEventListener("click", e => {
        const seatBox = e.target.closest(".seat-box");
        if(!seatBox) return;
        activeCard = seatBox.closest(".headshot-room-card");
        if(seatBox.classList.contains("filled")) { triggerLobbyTransition(activeCard); return; }
        if(!currentUser) { alert("Please login before joining a room."); switchPage(document.querySelector(".page.page-active"), loginPage); return; }
        activeSeatElement = seatBox;
        modalSeatTitle.textContent = `Seat #${seatBox.dataset.seat} Reservation`;
        modalSeatSubtitle.textContent = `Enter username for Seat ${seatBox.dataset.seat}`;
        modalInputLabel.textContent = `Username`;
        seatPlayerInput.value = currentUser.isAdmin ? "AdminPlayer" : currentUser.username;
        notificationModal.classList.add("active");
    });
});

modalCancelBtn.addEventListener("click", () => { notificationModal.classList.remove("active"); activeSeatElement = null; activeCard = null; });
modalConfirmBtn.addEventListener("click", () => {
    if(!activeSeatElement || !activeCard) return;
    const playerName = seatPlayerInput.value.trim();
    if(!playerName) { alert("Enter a valid username."); return; }
    const entryFee = parseInt(activeCard.dataset.entry);
    if(!currentUser.isAdmin && userWalletBalance < entryFee) { alert("Insufficient wallet balance!"); notificationModal.classList.remove("active"); return; }
    if(!currentUser.isAdmin) { userWalletBalance -= entryFee; updateWalletDisplay(); saveWallet(); }
    activeSeatElement.classList.add("filled");
    activeSeatElement.innerHTML = `<span>P${activeSeatElement.dataset.seat}</span><b>${playerName}</b>`;
    activeSeatElement.dataset.player = playerName;
    const max = parseInt(activeCard.dataset.max), filled = activeCard.querySelectorAll(".seat-box.filled").length;
    activeCard.querySelector(".member-status").textContent = `${filled} / ${max} Filled`;
    
    const slotName = activeCard.dataset.slot;
    const sourcePage = activeCard.closest("#brCardsContainer") ? brMapsPage : (activeCard.closest("#lonewolfCardsContainer") ? lonewolfModesPage : headshotTimesPage);
    if(!userJoinedMatches.some(m => m.slotName === slotName)) {
        userJoinedMatches.push({slotName, card: activeCard, sourcePage, seatNo: activeSeatElement.dataset.seat, playerName});
    }

    notificationModal.classList.remove("active");
    triggerLobbyTransition(activeCard);
    activeSeatElement = null; activeCard = null;
});

const lobbyRoomTitle = document.getElementById("lobbyRoomTitle"), lobbyRosterContainer = document.getElementById("lobbyRosterContainer"),
      credsDisplayStatus = document.getElementById("credsDisplayStatus");

document.getElementById("backToTimesBtn").addEventListener("click", () => {
    switchPage(roomLobbyPage, lastActiveSourcePage);
});

function playPaperTearSound() {
    try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const buffer = ctx.createBuffer(1, ctx.sampleRate * .4, ctx.sampleRate);
        const data = buffer.getChannelData(0);
        for(let i=0; i<buffer.length; i++) data[i] = (Math.random()*2-1) * Math.exp(-i / (ctx.sampleRate*.15));
        const src = ctx.createBufferSource(); src.buffer = buffer;
        const filter = ctx.createBiquadFilter(); filter.type = "bandpass"; filter.frequency.value = 1800; filter.Q.value = 3;
        const gain = ctx.createGain(); gain.gain.setValueAtTime(.6, ctx.currentTime); gain.gain.exponentialRampToValueAtTime(.01, ctx.currentTime+.4);
        src.connect(filter); filter.connect(gain); gain.connect(ctx.destination); src.start();
    } catch(e) {}
}

function triggerLobbyTransition(card, customSourcePage = null) {
    playPaperTearSound();
    const tearOverlay = card.querySelector(".tear-overlay");
    if(tearOverlay && card.classList) {
        tearOverlay.classList.add("active"); 
        card.classList.add("tearing");
    }
    currentActiveCard = card;
    const slotName = card.dataset.slot;
    lobbyRoomTitle.textContent = slotName + " Lobby";
    credsDisplayStatus.textContent = slotName.includes("BR") ? "ID pass will appear before 1 min in chat box 📦" : "NOMO-ROOM-77: Pass #4455";
    renderLobbyRoster(card);
    
    lastActiveSourcePage = customSourcePage || (card.closest("#brCardsContainer") ? brMapsPage : (card.closest("#lonewolfCardsContainer") ? lonewolfModesPage : headshotTimesPage));
    
    setTimeout(() => { 
        switchPage(document.querySelector(".page.page-active"), roomLobbyPage); 
        if(card.classList) {
            card.classList.remove("tearing"); 
            tearOverlay.classList.remove("active");
        }
    }, 600);
}

function renderLobbyRoster(card) {
    lobbyRosterContainer.innerHTML = "";
    card.querySelectorAll(".seat-box").forEach(seat => {
        const box = document.createElement("div"); box.className = "white-cardboard-box";
        const playerName = seat.dataset.player || "Open Slot";
        let adminActionHtml = "";
        if(currentUser && currentUser.isAdmin && seat.dataset.player) {
            adminActionHtml = `<button class="admin-wallet-btn" onclick="adminAddMoneyToPlayer(event, '${seat.dataset.player}')">Add Wallet ₹</button>`;
        }
        box.innerHTML = `<div><span>Player ${seat.dataset.seat}</span><b>${playerName}</b></div>${adminActionHtml}`;
        lobbyRosterContainer.appendChild(box);
    });
}

function toggleRosterView() {
    if(currentActiveCard) renderLobbyRoster(currentActiveCard);
}

function adminAddMoneyToPlayer(e, playerName) {
    e.stopPropagation();
    adminTopUpUser(playerName);
}

function renderMyMatches() {
    const container = document.getElementById("myMatchesContainer");
    if(userJoinedMatches.length === 0) {
        container.innerHTML = `<div style="grid-column: 1/-1; text-align: center; color: var(--text-muted); padding: 3rem 0;">You have not joined any rooms yet. Select a room and secure your seat!</div>`;
        return;
    }
    container.innerHTML = "";
    userJoinedMatches.forEach(match => {
        const item = document.createElement("div");
        item.className = "luxury-card";
        item.innerHTML = `
            <div>
                <span class="card-tag">Confirmed Reservation</span>
                <h3>${match.slotName}</h3>
                <div class="match-pricing">Your Seat: <span>#${match.seatNo}</span> Username: <span class="win-amount">${match.playerName}</span></div>
                <p>Room roster secured and active in tournament queue.</p>
            </div>
            <button class="cardboard-btn" style="margin-top:1rem;">View Lobby</button>`;
        item.querySelector("button").addEventListener("click", () => {
            triggerLobbyTransition(match.card, myMatchesPage);
        });
        container.appendChild(item);
    });
}

function openAdminLobbyDirect(lobbyName) {
    if(!currentUser || !currentUser.isAdmin) { alert("Admin login required."); switchPage(csModesPage, loginPage); return; }
    lobbyRoomTitle.textContent = lobbyName + " (Admin Override Lobby)";
    credsDisplayStatus.textContent = "NOMO-CS-ROOM: Pass #8899";
    lobbyRosterContainer.innerHTML = `<div class="white-cardboard-box"><span>Admin</span><b>👑 ADMIN</b></div><div class="white-cardboard-box"><span>Status</span><b>Full Control</b></div>`;
    lastActiveSourcePage = csModesPage; switchPage(csModesPage, roomLobbyPage);
}

function openAdminLobbyDirectFromCard(e, lobbyName) {
    e.stopPropagation();
    if(!currentUser || !currentUser.isAdmin) { alert("Admin login required."); return; }
    lobbyRoomTitle.textContent = lobbyName + " (Admin Override Lobby)";
    credsDisplayStatus.textContent = lobbyName.includes("BR") ? "ID pass will appear before 1 min in chat box 📦" : "NOMO-ROOM-99: Pass #1122";
    lobbyRosterContainer.innerHTML = `<div class="white-cardboard-box"><span>Admin</span><b>👑 ADMIN</b></div><div class="white-cardboard-box"><span>Status</span><b>Full Control</b></div>`;
    const card = e.target.closest(".headshot-room-card");
    lastActiveSourcePage = card?.closest("#brCardsContainer") ? brMapsPage : (card?.closest("#lonewolfCardsContainer") ? lonewolfModesPage : headshotTimesPage);
    switchPage(lastActiveSourcePage, roomLobbyPage);
}

const chatInput = document.getElementById("chatInput"), sendChatBtn = document.getElementById("sendChatBtn"),
      chatMessagesArea = document.getElementById("chatMessagesArea"), adminIndicatorBadge = document.getElementById("adminIndicatorBadge"),
      chatRestrictedNotice = document.getElementById("chatRestrictedNotice");

function updateChatPermissions() {
    const isAdmin = currentUser && currentUser.isAdmin;
    chatInput.disabled = !isAdmin; sendChatBtn.disabled = !isAdmin;
    chatInput.placeholder = isAdmin ? "Type broadcast message as admin..." : "Only administrators can send messages...";
    adminIndicatorBadge.textContent = isAdmin ? "👑 ADMIN MODE ACTIVE" : "Admin Only";
    chatRestrictedNotice.textContent = isAdmin ? "Admin controls active." : "Chat broadcasting is restricted to official tournament admins.";
}

sendChatBtn.addEventListener("click", () => {
    const text = chatInput.value.trim();
    if(!text || !currentUser || !currentUser.isAdmin) return;
    const msgDiv = document.createElement("div"); msgDiv.className = "chat-msg user-sent";
    msgDiv.innerHTML = `<div class="chat-msg-sender">👑 NOMO Arena Admin</div>${text}`;
    chatMessagesArea.appendChild(msgDiv); chatMessagesArea.scrollTop = chatMessagesArea.scrollHeight;
    chatInput.value = "";
});
chatInput.addEventListener("keypress", e => { if(e.key === "Enter") sendChatBtn.click(); });

// Support Chat Widget Logic
const supportChatWindow = document.getElementById("supportChatWindow");
const supportChatMessages = document.getElementById("supportChatMessages");
const supportChatInput = document.getElementById("supportChatInput");

function toggleSupportChat() {
    supportChatWindow.classList.toggle("active");
}

function sendSupportMessage() {
    const text = supportChatInput.value.trim();
    if(!text) return;
    
    // Add Customer Message
    const custMsg = document.createElement("div");
    custMsg.className = "support-msg customer";
    custMsg.innerHTML = `<b>You:</b> ${text}`;
    supportChatMessages.appendChild(custMsg);
    supportChatInput.value = "";
    supportChatMessages.scrollTop = supportChatMessages.scrollHeight;

    // Simulate Agent Auto-Reply after brief delay
    setTimeout(() => {
        const agentMsg = document.createElement("div");
        agentMsg.className = "support-msg agent";
        agentMsg.innerHTML = `<b>NOMO Agent:</b> Thanks for reaching out! Our support team has received your query regarding "${text}" and will assist you shortly.`;
        supportChatMessages.appendChild(agentMsg);
        supportChatMessages.scrollTop = supportChatMessages.scrollHeight;
    }, 1000);
}

supportChatInput.addEventListener("keypress", e => { if(e.key === "Enter") sendSupportMessage(); });

if(loadSession()) { updateHeaderAccount(); updateWalletDisplay(); updateAdminUI(); updateChatPermissions(); }
else { currentUser = null; userWalletBalance = 0; updateHeaderAccount(); updateWalletDisplay(); updateAdminUI(); updateChatPermissions(); }
</script>

function adjustMatchSlots(matchId, delta) {
    const matchesData = getStoredMatches();
    const match = matchesData[currentManagingCategory].find(m => m.id === matchId);
    if(!match) return;

    const newMax = match.max + delta;
    if(newMax < 2) {
        alert("A match must have at least 2 player slots.");
        return;
    }
    if(newMax > 50) {
        alert("Maximum limit of 50 seats reached.");
        return;
    }

    match.max = newMax;
    saveStoredMatches(matchesData);
    renderAdminMatchList();
    renderAllDynamicMatches();
}

